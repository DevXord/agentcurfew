{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/node_modules/agentcurfew/dist/cli.js",
              "hook"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
