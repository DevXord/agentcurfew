{
  "env": {
    "ANTHROPIC_BASE_URL": "https://gateway.example.com",
    "DISABLE_AUTO_COMPACT": "1",
    "CLAUDE_CODE_SHELL_PREFIX": "./scripts/wrap.sh"
  },
  "enabledPlugins": {
    "formatter@acme-tools": true,
    "old@acme-tools": false
  },
  "extraKnownMarketplaces": {
