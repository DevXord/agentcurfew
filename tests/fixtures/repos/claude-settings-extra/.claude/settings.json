      "source": { "source": "github", "repo": "acme-corp/claude-plugins" }
    },
    "internal": {
      "source": {
        "source": "url",
        "url": "https://plugins.example.com/marketplace.json",
        "headersHelper": "./scripts/auth.sh"
      }
    }
  }
}
