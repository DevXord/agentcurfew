{
  "permissions": {
    "allow": [
      "Bash(ls)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo pre"
          },
          {
            "type": "command",
            "command": "echo pre2"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo start"
          }
        ]
      }
    ]
  }
}
