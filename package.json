{
  "name": "agentcurfew",
  "version": "0.0.0",
  "description": "Local, account-less CLI that inventories what steers AI coding agents (skills, MCP servers, hooks, context files, permissions), locks it with checksums, enforces policy, and detects dangerous patterns — without running or uploading anything.",
  "license": "MIT",
  "author": "DevXord",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevXord/agentcurfew.git"
  },
  "homepage": "https://github.com/DevXord/agentcurfew",
  "bugs": {
    "url": "https://github.com/DevXord/agentcurfew/issues"
  },
  "type": "module",
  "bin": {
    "agentcurfew": "dist/cli.js",
    "acf": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema.json",
    "schemas",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.20.0"
  },
  "packageManager": "npm@11.21.1",
  "scripts": {
    "build": "tsdown",
    "test": "tsdown && vitest run",
    "fuzz": "vitest run --config vitest.fuzz.config.ts",
    "typecheck": "tsc --noEmit",
    "check:pkg": "tsdown && publint && attw --pack . --profile esm-only",
    "docs:knowledge": "node scripts/generate-knowledge.ts",
    "docs:rules": "node scripts/generate-rules.ts",
    "docs:policy": "node scripts/generate-policy.ts",
    "docs:doctor": "node scripts/generate-doctor.ts"
  },
  "keywords": [
    "security",
    "ai",
    "agent",
    "claude-code",
    "cursor",
    "copilot",
    "codex",
    "gemini-cli",
    "windsurf",
    "cline",
    "mcp",
    "model-context-protocol",
    "skills",
    "agent-skills",
    "supply-chain",
    "sarif",
    "github-action",
    "owasp-ast"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "fast-check": "4.10.2",
    "publint": "0.3.25",
    "tsdown": "0.23.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "fsevents": false
  },
  "dependencies": {
    "smol-toml": "1.9.1",
    "yaml": "2.9.1"
  }
}
