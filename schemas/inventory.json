{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unpkg.com/agentcurfew/schemas/inventory.json",
  "title": "agentcurfew scan --inventory --json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "components",
    "problems"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "producer": {
      "type": "object",
      "description": "What made this output: the tool, its version and the date of the newest fact in its knowledge base. No time, so outputs of the same project stay comparable.",
      "properties": {
        "name": {
          "const": "agentcurfew"
        },
        "version": {
          "type": "string"
        },
        "knowledge": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "name",
        "version",
        "knowledge"
      ]
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "kind",
          "agents",
          "scope",
          "file",
          "name",
          "bytes"
        ],
        "properties": {
          "kind": {
            "enum": [
              "skill",
              "mcp-server",
              "hook",
              "auto-run",
              "context-file",
              "permission",
              "subagent",
              "command",
              "command-setting",
              "setting"
            ]
          },
          "agents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scope": {
            "enum": [
              "project",
              "user",
              "managed"
            ]
          },
          "file": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "The component's stable id: its name, or for a hook its event, matcher and a hash of the handler, so it stays when a hook is added before it."
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "path",
                "bytes"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "The checksum agentcurfew.lock holds for this component."
          }
        }
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "code",
          "file"
        ],
        "properties": {
          "code": {
            "enum": [
              "outside-project",
              "too-large",
              "too-deep",
              "too-many-entries",
              "unreadable",
              "unparsable"
            ]
          },
          "file": {
            "type": "string"
          }
        }
      }
    }
  }
}
