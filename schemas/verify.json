{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unpkg.com/agentcurfew/schemas/verify.json",
  "title": "agentcurfew verify --json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "ok",
    "changes",
    "skillsLock",
    "problems"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "producer": {
      "type": "object",
      "description": "What made this output: the tool, its version and the date of the newest fact in its knowledge base. No time, so outputs of the same project stay comparable.",
      "properties": {
        "name": {
          "const": "agentcurfew"
        },
        "version": {
          "type": "string"
        },
        "knowledge": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "name",
        "version",
        "knowledge"
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "type",
          "kind",
          "file",
          "name",
          "details"
        ],
        "properties": {
          "type": {
            "enum": [
              "added",
              "removed",
              "changed"
            ]
          },
          "kind": {
            "enum": [
              "skill",
              "mcp-server",
              "hook",
              "auto-run",
              "context-file",
              "permission",
              "subagent",
              "command",
              "command-setting"
            ]
          },
          "file": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "The component's stable id: its name, or for a hook its event, matcher and a hash of the handler, so it stays when a hook is added before it."
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "lockDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "The sha256 of the agentcurfew.lock that agentcurfew lock would write now."
    },
    "lockWithoutIds": {
      "const": true,
      "description": "Present when the lock was written before component ids (agentcurfew 1.0) and was compared by name; run agentcurfew lock to add them."
    },
    "skillsLock": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "kind",
          "file",
          "name",
          "message"
        ],
        "properties": {
          "kind": {
            "enum": [
              "skill",
              "mcp-server",
              "hook",
              "auto-run",
              "context-file",
              "permission",
              "subagent",
              "command",
              "command-setting"
            ]
          },
          "file": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "level": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "line": {
            "type": "integer",
            "minimum": 0
          },
          "column": {
            "type": "integer",
            "minimum": 0
          },
          "inFile": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          }
        }
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "code",
          "file"
        ],
        "properties": {
          "code": {
            "enum": [
              "outside-project",
              "too-large",
              "too-deep",
              "too-many-entries",
              "unreadable",
              "unparsable"
            ]
          },
          "file": {
            "type": "string"
          }
        }
      }
    }
  }
}
