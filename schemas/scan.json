{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unpkg.com/agentcurfew/schemas/scan.json",
  "title": "agentcurfew scan --json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "failOn",
    "components",
    "findings",
    "suppressed",
    "problems"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "failOn": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "none"
      ]
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "kind",
          "agents",
          "scope",
          "file",
          "name",
          "bytes"
        ],
        "properties": {
          "kind": {
            "enum": [
              "skill",
              "mcp-server",
              "hook",
              "auto-run",
              "context-file",
              "permission",
              "subagent",
              "command"
            ]
          },
          "agents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scope": {
            "enum": [
              "project",
              "user",
              "managed"
            ]
          },
          "file": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "path",
                "bytes"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "rule",
          "level",
          "kind",
          "file",
          "name",
          "message"
        ],
        "properties": {
          "rule": {
            "type": "string"
          },
          "level": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "kind": {
            "enum": [
              "skill",
              "mcp-server",
              "hook",
              "auto-run",
              "context-file",
              "permission",
              "subagent",
              "command"
            ]
          },
          "file": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          },
          "message": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          },
          "policy": {
            "type": "string"
          }
        }
      }
    },
    "suppressed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "finding",
          "reason"
        ],
        "properties": {
          "finding": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "rule",
              "level",
              "kind",
              "file",
              "name",
              "message"
            ],
            "properties": {
              "rule": {
                "type": "string"
              },
              "level": {
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low",
                  "info"
                ]
              },
              "kind": {
                "enum": [
                  "skill",
                  "mcp-server",
                  "hook",
                  "auto-run",
                  "context-file",
                  "permission",
                  "subagent",
                  "command"
                ]
              },
              "file": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "column": {
                "type": "integer",
                "minimum": 1
              },
              "message": {
                "type": "string"
              },
              "tag": {
                "type": "string"
              },
              "policy": {
                "type": "string"
              }
            }
          },
          "reason": {
            "type": "string"
          },
          "until": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "code",
          "file"
        ],
        "properties": {
          "code": {
            "enum": [
              "outside-project",
              "too-large",
              "too-deep",
              "too-many-entries",
              "unreadable",
              "unparsable"
            ]
          },
          "file": {
            "type": "string"
          }
        }
      }
    }
  }
}
