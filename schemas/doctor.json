{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unpkg.com/agentcurfew/schemas/doctor.json",
  "title": "agentcurfew doctor --json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "failOn",
    "ok",
    "checks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "failOn": {
      "enum": [
        "error",
        "warning",
        "info",
        "none"
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "title",
          "status",
          "fix",
          "hits"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not applicable"
            ]
          },
          "fix": {
            "type": "string"
          },
          "hits": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "file",
                "message",
                "level",
                "sources"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "level": {
                  "enum": [
                    "error",
                    "warning",
                    "info"
                  ]
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
